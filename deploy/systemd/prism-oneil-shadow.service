[Unit]
Description=PRISM adaptive execution worker (SHADOW unless explicitly approved)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/prism-insight
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/.pyenv/shims/python3 /root/prism-insight/tools/run_oneil_execution.py --config /root/prism-insight/runtime/oneil-execution.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
